# ── Copy this to .env and fill in your values ─────────────────────────────

# Azure SQL Managed Instance
SQL_SERVER=your-mi.database.windows.net
SQL_DATABASE=YourClinicalDB
SQL_USERNAME=your_sql_user
SQL_PASSWORD=your_sql_password
# Port: 3342 for Azure SQL MI public endpoint, 1433 for private endpoint or regular Azure SQL DB
SQL_PORT=3342

# Table and column configuration
PATIENT_TABLE=Customers
PATIENT_DATE_COLUMN=CREATE_DATE
ENCOUNTER_TABLE=PATIENT_ENCOUNTERS
ENCOUNTER_DATE_COLUMN=ENCOUNTER_DATE

# Collections (money received)
PAYMENT_TABLE=PMS_PAYMENTS
PAYMENT_DATE_COLUMN=PAYMENT_RECEIVED_DATE
PAYMENT_AMOUNT_COLUMN=PAYMENT_AMOUNT
PAYMENT_VOID_COLUMN=IS_VOID

# Contact lens sales
CL_ORDER_TABLE=PMS_OPTICAL_ORDERS
CL_ORDER_DATE_COLUMN=ORDER_DATE
CL_DETAIL_TABLE=PMS_OPTICAL_ORDER_CONTACT_LENS_DETAILS

# Holiday country (US, GB, AU, CA etc.)
HOLIDAY_COUNTRY=US

# Forecast defaults
DEFAULT_FORECAST_MONTHS=12
DEFAULT_START_YEAR=2019

# Outlier detection sensitivity (higher = less aggressive filtering)
MONTH_OUTLIER_MAD_THRESHOLD=20.0
TXN_OUTLIER_MAD_THRESHOLD=18.0

# ── Predictions storage (MySQL) — see db/predictions_store.py ────────────
# Where computed forecast reports get written instead of outputs/*.json,
# so they survive an ephemeral filesystem (e.g. Render). If left unset,
# the app falls back to local files, same as before this existed.
PREDICTIONS_DB_HOST=your-mysql-server.mysql.database.azure.com
PREDICTIONS_DB_PORT=3306
PREDICTIONS_DB_NAME=predictions_db
PREDICTIONS_DB_USER=your_mysql_user
PREDICTIONS_DB_PASSWORD=your_mysql_password

# ── Azure ML (only needed for azure_automl.py) ────────────────────────────
AML_SUBSCRIPTION_ID=your-subscription-id
AML_RESOURCE_GROUP=your-resource-group
AML_WORKSPACE_NAME=your-workspace-name
AML_COMPUTE_NAME=cpu-cluster
